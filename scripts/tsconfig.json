{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Node",
        "lib": [
            "ES2022"
        ],
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "strict": false,
        "resolveJsonModule": true,
        "types": [
            "node"
        ],
        "outDir": "dist"
    },
    "include": [
        "./tiny-vue-skill-post-process/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}